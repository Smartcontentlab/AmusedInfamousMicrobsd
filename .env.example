DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# Encrypts the Hermes/OpenClaw tokens stored in the database.
# Use a long random string. If you change it, saved runtime credentials stop decrypting
# and must be re-entered — so use a DIFFERENT value on each machine and re-add the links there.
SESSION_SECRET=change-me

PORT=5000

# NVIDIA NIM — powers the model dropdown on every agent and game-show contestant.
# Get a key at https://build.nvidia.com (free tier available). Without it the
# dropdown just shows "not configured" and everything else still works.
NVIDIA_API_KEY=

# Only override if you self-host NIM instead of NVIDIA's hosted endpoint.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily — gives game-show contestants real web search (free tier, no card).
# Without it they can still read pages, just not search. https://tavily.com
TAVILY_API_KEY=

# Stripe TEST MODE key — the game show's race bar is scored from payments Stripe
# confirms, not from what a contestant claims it earned. Create a restricted key
# at https://dashboard.stripe.com/test/apikeys with read access to Payment Intents.
# Live keys are rejected on purpose: the show never runs on real money.
# Leave this empty and the race falls back to the seeded demo figures.
STRIPE_API_KEY=
